<?xml version="1.0" encoding="UTF-8"?>
<Form
	xmlns="http://schema.picoe.ca/eto.forms" 
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="MkvDefaultTrackChanger"
    MinimumSize="800,450"
  	Size="800, 450"
	Padding="10"
    AllowDrop="true"
    DragEnter="OnDragEnter"
    DragDrop="OnDragDrop"
    >

    <DynamicLayout Spacing="3,3" Padding="3,3,3,3">
        
        <StackLayout Spacing="3" HorizontalContentAlignment="Center">
            <Button x:Name="btnBrowse" Click="BtnBrowseFilesClick">Click here to browse files (Drag and drop can be used instead)</Button>
            <Label x:Name="lblFilesSelected" Text=""></Label>
        </StackLayout>

        <StackLayout Spacing="3" HorizontalContentAlignment="Center">
            <Label x:Name="lblCurrentFile" Text="" TextAlignment="Center"></Label>
            <StackLayout Orientation="Horizontal" Spacing="10" HorizontalContentAlignment="Center">
                <Button x:Name="btnPrevious" Text="Previous" Enabled="false" Click="BtnPreviousClicked"></Button>
                <Button x:Name="btnNext" Text="Next" Enabled="false" Click="BtnNextClicked"></Button>
            </StackLayout>
        </StackLayout>

        <DynamicLayout Spacing="3,3">
            <Label TextAlignment="Center">Audio</Label>
            <Label x:Name="lblCurrentAudio" Text="" TextAlignment="Center" Font="SystemFont=Default, Size=8" TextColor="#666"></Label>
            <DropDown x:Name="dropdownAudio" Enabled="false" SelectedKeyChanged="OnDropdownSelectionChanged"></DropDown>
        </DynamicLayout>

        <DynamicLayout Spacing="3,3">
            <Label TextAlignment="Center">Subtitles</Label>
            <Label x:Name="lblCurrentSubtitles" Text="" TextAlignment="Center" Font="SystemFont=Default, Size=8" TextColor="#666"></Label>
            <DropDown x:Name="dropdownSubtitles" Enabled="false" SelectedKeyChanged="OnDropdownSelectionChanged"></DropDown>
        </DynamicLayout>

        <StackLayout Spacing="3" HorizontalContentAlignment="Center">
            <StackLayout Orientation="Horizontal" Spacing="5" HorizontalContentAlignment="Center">
                <Button x:Name="btnApply" Enabled="false" Click="BtnApplyClicked">Apply</Button>
                <Button x:Name="btnApplyAll" Enabled="false" Click="BtnApplyAllClicked">Apply All</Button>
                <Button x:Name="btnHelp" Enabled="true" Click="BtnHelpClicked">Command Line Usage Help</Button>
            </StackLayout>
        </StackLayout>
        
        <StackLayout Spacing="0" HorizontalContentAlignment="Left">
            <CheckBox x:Name="donotmodifyaudiotracks" Text="Do not modify audio tracks for apply all"></CheckBox>
            <CheckBox x:Name="donotmodifysubtitletracks" Text="Do not modify subtitles for apply all"></CheckBox>
            <CheckBox x:Name="disableAudioLanguageCheck" Text="Disable language check for audio tracks for apply all"></CheckBox>
            <CheckBox x:Name="disableAudioNameCheck" Text="Disable name check for audio tracks for apply all"></CheckBox>
            <CheckBox x:Name="disableSubtitleLanguageCheck" Text="Disable language check for subtitles tracks for apply all"></CheckBox>
            <CheckBox x:Name="disableSubtitleNameCheck" Text="Disable name check for subtiltes tracks for apply all"></CheckBox>
            <CheckBox
                x:Name="NoForcedSubtitles"
                Text="Set forced subtitles to be unforced even if there are no default subtitle changes (Overrides do not modify subtitles)"
                CheckedChanged="NoForcedSubtitlesChanged"
            >
            </CheckBox>
        </StackLayout>

        <StackLayout Spacing="3" HorizontalContentAlignment="Center">
            <Label x:Name="lblStatus" Text=""></Label>
        </StackLayout>
        
        <StackLayout Spacing="3" HorizontalContentAlignment="left" VerticalContentAlignment="Top">
            <Label x:Name="Label1" TextAlignment="Left"></Label>
        </StackLayout>

        <StackLayout Spacing="3" HorizontalContentAlignment="left" VerticalContentAlignment="Top">
            <Label x:Name="Label2" TextAlignment="Left"></Label>
        </StackLayout>
            
    </DynamicLayout>
   
	<Form.Menu>
		<MenuBar>
			<MenuBar.AboutItem>
				<ButtonMenuItem Text="About..." Click="HandleAbout" />
			</MenuBar.AboutItem>
		</MenuBar>
	</Form.Menu>
</Form>